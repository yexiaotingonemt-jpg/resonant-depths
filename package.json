{
  "name": "resonant-depths",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "server:dev": "wrangler dev --config server/wrangler.jsonc --port 8787",
    "server:deploy": "wrangler deploy --config server/wrangler.jsonc",
    "test:online": "node scripts/browser-online.cjs",
    "test:art": "node scripts/browser-art.cjs",
    "test:growth": "node scripts/browser-growth.cjs",
    "test:balance": "tsx scripts/balance-builds.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "wrangler": "^4.152.0"
  }
}
